      { "name": "VersionInspector", "states": ["current", "note preview", "document checkpoint labeled separately", "restored new revision"] },
      { "name": "ReplayTray", "states": ["paused", "playing", "scrubbing", "unknown interval", "complete"], "notes": ["Captured paths reveal with elapsed timing; unknown changes jump at next snapshot."] }
