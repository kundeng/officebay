    "layout": { "shell": "Existing tab strip, compact ribbon, agent pane, status bar", "regions": ["Optional agent pane at left", "Sections and notes", "Page canvas", "Layers or Versions inspector", "Optional replay tray"], "responsiveReflow": ["Below 1300px agent becomes a dismissible overlay", "Below 1050px inspector becomes a dismissible overlay", "Below 760px note navigation becomes a dismissible overlay; retain canvas and replay controls"] },
    "components": [
